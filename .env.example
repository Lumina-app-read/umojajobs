# Modèle de configuration locale. Copier en `.env` (jamais versionné) et remplacer les valeurs.
# Aucune valeur de ce fichier ne doit être utilisée en production.

# --- Application ---
NODE_ENV=development
API_PORT=4000

# --- PostgreSQL (Docker Compose de développement) ---
POSTGRES_USER=opportinities
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=opportinities
POSTGRES_PORT=5432

# URL de connexion utilisée par l'API et Prisma (doit correspondre aux valeurs ci-dessus).
DATABASE_URL=postgresql://opportinities:change-me-local-only@localhost:5432/opportinities?schema=public

# --- Redis (Docker Compose de développement) ---
REDIS_PASSWORD=change-me-local-only
# Changer ce port si 6379 est déjà occupé sur le poste (ex. Memurai, Redis local).
REDIS_PORT=6379

# --- Mailpit (capture des emails en développement) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Application web (liens des emails, origine autorisée pour la protection CSRF) ---
APP_URL=http://localhost:3000

# --- Redis : URL utilisée par l'API (doit correspondre aux valeurs ci-dessus) ---
REDIS_URL=redis://:change-me-local-only@localhost:6379/0

# --- Sécurité ---
# Clé AES-256 (32 octets en base64) qui chiffre les secrets TOTP. Générer :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=remplacer-par-une-cle-generee-de-32-octets-en-base64=
# Cookies Secure (préfixe __Host-). false uniquement en développement local (http).
COOKIE_SECURE=false
# Nombre de proxys de confiance devant l'API (1 derrière Nginx en production).
TRUST_PROXY=0
SESSION_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_HOURS=168
# Sessions donnant accès à l'administration : plus courtes
PRIVILEGED_SESSION_TTL_HOURS=6
PRIVILEGED_SESSION_IDLE_TIMEOUT_MINUTES=15
# Activation et expiration automatiques des offres (BullMQ, chaque minute)
SCHEDULED_TASKS_ENABLED=true
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Version des conditions d'utilisation acceptées à l'inscription.
TERMS_VERSION=2026-11-09

# --- Emails (Mailpit en développement, Brevo SMTP en production) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=OPPORTINITIES <no-reply@opportinities.local>

# --- Stockage objet privé (Garage en développement, fournisseur S3 en production) ---
GARAGE_RPC_SECRET=<64 caractères hexadécimaux : openssl rand -hex 32>
GARAGE_ADMIN_TOKEN=<jeton : openssl rand -base64 32>
GARAGE_S3_PORT=3900
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=oppo-private
S3_ACCESS_KEY_ID=GK<24 caractères hexadécimaux>
S3_SECRET_ACCESS_KEY=<64 caractères hexadécimaux>
S3_FORCE_PATH_STYLE=true
# Liens de téléchargement signés (secondes) et taille maximale d'un document (Mo)
FILE_URL_TTL_SECONDS=60
JOB_FILE_MAX_MB=10

# OpenAI (Career Studio, phase 4) : la vraie clé va uniquement dans .env
OPENAI_API_KEY=
OPENAI_MODEL=
