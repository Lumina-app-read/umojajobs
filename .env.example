# Modèle de configuration locale. Copier en `.env` (jamais versionné) et remplacer les valeurs.
# Aucune valeur de ce fichier ne doit être utilisée en production.

# --- Application ---
NODE_ENV=development
API_PORT=4000

# --- PostgreSQL (Docker Compose de développement) ---
POSTGRES_USER=opportinities
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=opportinities
POSTGRES_PORT=5432

# --- Redis (Docker Compose de développement) ---
REDIS_PASSWORD=change-me-local-only
# Changer ce port si 6379 est déjà occupé sur le poste (ex. Memurai, Redis local).
REDIS_PORT=6379

# --- Mailpit (capture des emails en développement) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
