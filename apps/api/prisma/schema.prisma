// Schéma de données OPPORTINITIES (PostgreSQL, Prisma 7).
// Conventions : identifiants UUID v7, colonnes et tables en snake_case, dates en timestamptz.
// Le schéma est complété module par module, au fil des phases.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Référentiel des 54 États africains (source : packages/shared/src/countries.ts).
model Country {
  id              String   @id @default(uuid(7)) @db.Uuid
  iso2            String   @unique @db.Char(2)
  iso3            String   @unique @db.Char(3)
  nameFr          String   @map("name_fr") @db.VarChar(100)
  nameEn          String   @map("name_en") @db.VarChar(100)
  officialNameFr  String   @map("official_name_fr") @db.VarChar(150)
  officialNameEn  String   @map("official_name_en") @db.VarChar(150)
  /// Indicatif international au format E.164, par exemple « +243 ».
  dialCode        String   @map("dial_code") @db.VarChar(6)
  flagEmoji       String   @map("flag_emoji") @db.VarChar(16)
  currencyCode    String   @map("currency_code") @db.Char(3)
  defaultTimezone String   @map("default_timezone") @db.VarChar(64)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cities    City[]
  users     User[]
  jobOffers JobOffer[]

  @@map("countries")
}

enum CitySource {
  geonames
  admin

  @@map("city_source")
}

/// Villes : import GeoNames (CC BY 4.0) et ajouts de l'administration.
model City {
  id          String     @id @default(uuid(7)) @db.Uuid
  countryId   String     @map("country_id") @db.Uuid
  /// Identifiant GeoNames ; vide pour une ville ajoutée par l'administration.
  geonamesId  Int?       @unique @map("geonames_id")
  name        String     @db.VarChar(200)
  asciiName   String     @map("ascii_name") @db.VarChar(200)
  /// Nom normalisé pour la recherche (minuscules, sans accents).
  searchName  String     @map("search_name") @db.VarChar(200)
  regionName  String?    @map("region_name") @db.VarChar(200)
  latitude    Decimal?   @db.Decimal(9, 6)
  longitude   Decimal?   @db.Decimal(9, 6)
  population  Int        @default(0)
  timezone    String     @db.VarChar(64)
  featureCode String?    @map("feature_code") @db.VarChar(10)
  source      CitySource @default(geonames)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  country   Country    @relation(fields: [countryId], references: [id], onDelete: Restrict)
  jobOffers JobOffer[]

  @@index([countryId, population(sort: Desc)])
  @@index([searchName(ops: raw("gin_trgm_ops"))], type: Gin, map: "cities_search_name_trgm_idx")
  @@map("cities")
}

// ---------------------------------------------------------------------------
// Phase 1c — Identité, sessions, rôles et sécurité
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended

  @@map("user_status")
}

enum Locale {
  fr
  en

  @@map("locale")
}

enum ThemePreference {
  light
  dark
  system

  @@map("theme_preference")
}

enum RoleCode {
  user
  moderator
  admin
  super_admin

  @@map("role_code")
}

enum VerificationTokenType {
  email_verification
  password_reset

  @@map("verification_token_type")
}

enum SecurityEventType {
  user_registered
  registration_attempt_existing_email
  email_verification_sent
  email_verified
  login_succeeded
  login_failed
  account_locked
  logout
  logout_all
  session_revoked
  password_reset_requested
  password_reset_completed
  password_changed
  mfa_enrollment_started
  mfa_enabled
  mfa_verified
  mfa_failed
  mfa_recovery_code_used
  role_granted
  role_revoked
  profile_updated
  contributor_terms_accepted

  @@map("security_event_type")
}

/// Compte unique : recherche d'emploi, publication, commissions et documents.
model User {
  id                         String          @id @default(uuid(7)) @db.Uuid
  /// Insensible à la casse (citext) : une seule inscription par adresse.
  email                      String          @unique @db.Citext
  passwordHash               String          @map("password_hash") @db.VarChar(255)
  firstName                  String          @map("first_name") @db.VarChar(100)
  lastName                   String          @map("last_name") @db.VarChar(100)
  countryId                  String          @map("country_id") @db.Uuid
  /// Facultatif, au format E.164 (profil ou moment d'un paiement).
  phoneE164                  String?         @map("phone_e164") @db.VarChar(16)
  locale                     Locale          @default(fr)
  theme                      ThemePreference @default(system)
  status                     UserStatus      @default(active)
  emailVerifiedAt            DateTime?       @map("email_verified_at") @db.Timestamptz(3)
  termsAcceptedAt            DateTime        @map("terms_accepted_at") @db.Timestamptz(3)
  termsVersion               String          @map("terms_version") @db.VarChar(32)
  /// Conditions de publication des offres : version acceptée et date (preuve d'acceptation).
  contributorTermsVersion    String?         @map("contributor_terms_version") @db.VarChar(32)
  contributorTermsAcceptedAt DateTime?       @map("contributor_terms_accepted_at") @db.Timestamptz(3)
  failedLoginCount           Int             @default(0) @map("failed_login_count")
  lockedUntil                DateTime?       @map("locked_until") @db.Timestamptz(3)
  lastLoginAt                DateTime?       @map("last_login_at") @db.Timestamptz(3)
  /// Secret TOTP chiffré (AES-256-GCM). Jamais stocké ni renvoyé en clair.
  totpSecretEncrypted        String?         @map("totp_secret_encrypted") @db.VarChar(255)
  totpPendingSecretEncrypted String?         @map("totp_pending_secret_encrypted") @db.VarChar(255)
  totpEnabledAt              DateTime?       @map("totp_enabled_at") @db.Timestamptz(3)
  /// Dernier pas de temps TOTP accepté : empêche la réutilisation d'un code.
  totpLastUsedStep           Int?            @map("totp_last_used_step")
  createdAt                  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  country            Country                 @relation(fields: [countryId], references: [id], onDelete: Restrict)
  roles              UserRole[]              @relation("UserRoles")
  rolesAssigned      UserRole[]              @relation("RoleAssignedBy")
  sessions           Session[]
  verificationTokens VerificationToken[]
  recoveryCodes      MfaRecoveryCode[]
  securityEvents     SecurityEvent[]
  jobOffers          JobOffer[]              @relation("JobOfferContributor")
  reviewedJobOffers  JobOffer[]              @relation("JobOfferReviewer")
  jobStatusChanges   JobOfferStatusHistory[] @relation("JobOfferStatusActor")
  jobRevisions       JobOfferRevision[]      @relation("JobOfferRevisionAuthor")
  jobFiles           JobOfferFile[]          @relation("JobOfferFileUploader")
  fileDownloads      FileDownloadLog[]       @relation("FileDownloader")
  savedJobs          SavedJob[]

  @@index([countryId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        RoleCode         @unique
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String           @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  /// Vide lorsque le rôle est attribué automatiquement (inscription) ou en ligne de commande.
  assignedById String?  @map("assigned_by_id") @db.Uuid
  user         User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?    @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Session serveur révocable. Seule l'empreinte SHA-256 du jeton est stockée.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  ip            String?   @db.VarChar(45)
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  /// Date de validation du TOTP pour cette session. L'obligation dépend des rôles actuels (admin, super_admin).
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(50)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Jetons à usage unique (vérification d'email, réinitialisation). Empreinte SHA-256 uniquement.
model VerificationToken {
  id        String                @id @default(uuid(7)) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  type      VerificationTokenType
  tokenHash String                @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?             @map("used_at") @db.Timestamptz(3)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

/// Codes de secours TOTP (usage unique). Empreinte SHA-256 uniquement.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

/// Journal des événements de sécurité. Ajout uniquement : UPDATE et DELETE bloqués par trigger.
model SecurityEvent {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String?           @map("user_id") @db.Uuid
  type      SecurityEventType
  ip        String?           @db.VarChar(45)
  userAgent String?           @map("user_agent") @db.VarChar(512)
  requestId String?           @map("request_id") @db.VarChar(64)
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User?             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("security_events")
}

// --- Offres d'emploi (phase 2) -------------------------------------------------------------

/// Cycle de vie d'une offre (cahier des charges §7.5). Aucune offre n'est publiée sans modération.
enum JobOfferStatus {
  draft
  pending_review
  needs_correction
  scheduled
  active
  expired
  rejected
  suspended
  archived

  @@map("job_offer_status")
}

enum ContractType {
  permanent
  fixed_term
  internship
  apprenticeship
  freelance
  consultancy
  temporary
  volunteer
  other

  @@map("contract_type")
}

enum WorkMode {
  on_site
  remote
  hybrid

  @@map("work_mode")
}

enum EducationLevel {
  none
  secondary
  vocational
  bachelor
  master
  doctorate

  @@map("education_level")
}

enum ExperienceLevel {
  none
  junior
  intermediate
  senior
  expert

  @@map("experience_level")
}

enum SalaryPeriod {
  hour
  day
  month
  year

  @@map("salary_period")
}

/// Sources possibles d'une annonce (cahier des charges §7.3).
enum JobSourceType {
  company_website
  whatsapp
  facebook
  telegram
  linkedin
  newspaper
  other_website
  other

  @@map("job_source_type")
}

/// Catégories professionnelles, administrables (noms en français et en anglais).
model JobCategory {
  id        String     @id @default(uuid(7)) @db.Uuid
  slug      String     @unique @db.VarChar(80)
  nameFr    String     @map("name_fr") @db.VarChar(120)
  nameEn    String     @map("name_en") @db.VarChar(120)
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  offers    JobOffer[]

  @@map("job_categories")
}

/// Offre partagée par un contributeur. Les champs « application » sont privés : révélés seulement
/// après déverrouillage (phase 3). Les dates de validité sont des dates calendaires interprétées
/// dans le fuseau « timezone » ; starts_at et ends_at en sont l'équivalent UTC (fin exclusive).
model JobOffer {
  id                      String           @id @default(uuid(7)) @db.Uuid
  contributorId           String           @map("contributor_id") @db.Uuid
  status                  JobOfferStatus   @default(draft)
  title                   String?          @db.VarChar(200)
  companyName             String?          @map("company_name") @db.VarChar(200)
  countryId               String?          @map("country_id") @db.Uuid
  cityId                  String?          @map("city_id") @db.Uuid
  categoryId              String?          @map("category_id") @db.Uuid
  contractType            ContractType?    @map("contract_type")
  workMode                WorkMode?        @map("work_mode")
  educationLevel          EducationLevel?  @map("education_level")
  experienceLevel         ExperienceLevel? @map("experience_level")
  salaryMin               Decimal?         @map("salary_min") @db.Decimal(14, 2)
  salaryMax               Decimal?         @map("salary_max") @db.Decimal(14, 2)
  salaryCurrency          String?          @map("salary_currency") @db.Char(3)
  salaryPeriod            SalaryPeriod?    @map("salary_period")
  description             String?
  requirements            String?
  skills                  String[]         @default([]) @db.VarChar(80)
  /// Langue de rédaction de l'annonce (conservée telle quelle, jamais traduite).
  contentLanguage         Locale?          @map("content_language")
  startDate               DateTime?        @map("start_date") @db.Date
  endDate                 DateTime?        @map("end_date") @db.Date
  timezone                String?          @db.VarChar(64)
  startsAt                DateTime?        @map("starts_at") @db.Timestamptz(3)
  endsAt                  DateTime?        @map("ends_at") @db.Timestamptz(3)
  sourceType              JobSourceType?   @map("source_type")
  sourceUrl               String?          @map("source_url") @db.VarChar(2048)
  sourceDetails           String?          @map("source_details") @db.VarChar(300)
  applicationInstructions String?          @map("application_instructions")
  applicationEmail        String?          @map("application_email") @db.Citext
  applicationUrl          String?          @map("application_url") @db.VarChar(2048)
  applicationAddress      String?          @map("application_address") @db.VarChar(500)
  /// Identifiant d'URL public (intitulé, entreprise, ville), attribué à la validation. Stable ensuite.
  slug                    String?          @unique @db.VarChar(180)
  /// Texte normalisé (minuscules, sans accents) pour la recherche : intitulé, entreprise,
  /// compétences, exigences et description. Index trigramme (pg_trgm).
  searchText              String?          @map("search_text")
  /// Empreinte de détection des doublons (entreprise, intitulé, pays normalisés).
  duplicateKey            String?          @map("duplicate_key") @db.Char(64)
  declarationAcceptedAt   DateTime?        @map("declaration_accepted_at") @db.Timestamptz(3)
  submittedAt             DateTime?        @map("submitted_at") @db.Timestamptz(3)
  reviewedAt              DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  reviewedById            String?          @map("reviewed_by_id") @db.Uuid
  publishedAt             DateTime?        @map("published_at") @db.Timestamptz(3)
  expiredAt               DateTime?        @map("expired_at") @db.Timestamptz(3)
  /// Incrémenté à chaque modification : protège contre les écritures concurrentes.
  version                 Int              @default(1)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  contributor   User                    @relation("JobOfferContributor", fields: [contributorId], references: [id], onDelete: Restrict)
  reviewedBy    User?                   @relation("JobOfferReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  country       Country?                @relation(fields: [countryId], references: [id], onDelete: Restrict)
  city          City?                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  category      JobCategory?            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  statusHistory JobOfferStatusHistory[]
  revisions     JobOfferRevision[]
  files         JobOfferFile[]
  savedBy       SavedJob[]

  @@index([contributorId, createdAt(sort: Desc)])
  @@index([status, submittedAt])
  @@index([status, startsAt])
  @@index([status, endsAt])
  @@index([duplicateKey])
  @@index([sourceUrl])
  @@index([status, publishedAt(sort: Desc)])
  @@index([status, countryId, categoryId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "job_offers_search_text_trgm_idx")
  @@map("job_offers")
}

/// Historique des changements de statut, en ajout seul (acteur, rôles, motif, contexte réseau).
model JobOfferStatusHistory {
  id         String          @id @default(uuid(7)) @db.Uuid
  jobOfferId String          @map("job_offer_id") @db.Uuid
  fromStatus JobOfferStatus? @map("from_status")
  toStatus   JobOfferStatus  @map("to_status")
  /// null : changement automatique (activation ou expiration planifiée).
  actorId    String?         @map("actor_id") @db.Uuid
  actorRoles String[]        @default([]) @map("actor_roles") @db.VarChar(32)
  reason     String?
  ip         String?         @db.VarChar(45)
  userAgent  String?         @map("user_agent") @db.VarChar(512)
  requestId  String?         @map("request_id") @db.VarChar(64)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  jobOffer JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Restrict)
  actor    User?    @relation("JobOfferStatusActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([jobOfferId, createdAt])
  @@map("job_offer_status_history")
}

/// Version soumise d'une offre (instantané figé à chaque soumission), en ajout seul.
model JobOfferRevision {
  id         String   @id @default(uuid(7)) @db.Uuid
  jobOfferId String   @map("job_offer_id") @db.Uuid
  number     Int
  authorId   String   @map("author_id") @db.Uuid
  snapshot   Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  jobOffer JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Restrict)
  author   User     @relation("JobOfferRevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([jobOfferId, number])
  @@map("job_offer_revisions")
}

// --- Fichiers des offres (phase 2c) --------------------------------------------------------

enum JobOfferFileKind {
  /// Annonce originale (PDF), une seule par offre.
  original
  /// Document complémentaire (formulaire, fiche de poste…).
  attachment

  @@map("job_offer_file_kind")
}

enum FileDownloadPurpose {
  /// Le contributeur consulte son propre document.
  owner
  /// Un modérateur examine le document.
  moderation
  /// Un utilisateur ayant déverrouillé l'offre (phase 3).
  unlock

  @@map("file_download_purpose")
}

/// Document privé d'une offre : stocké hors accès public, servi par URL signée de courte durée.
/// Index partiel « job_offer_files_one_original_idx » (une seule annonce originale par offre) créé
/// en SQL dans la migration add_job_offer_files : à conserver si une migration générée le supprime.
model JobOfferFile {
  id           String           @id @default(uuid(7)) @db.Uuid
  jobOfferId   String           @map("job_offer_id") @db.Uuid
  uploadedById String           @map("uploaded_by_id") @db.Uuid
  kind         JobOfferFileKind
  /// Clé dans le stockage objet privé (jamais exposée).
  storageKey   String           @unique @map("storage_key") @db.VarChar(300)
  originalName String           @map("original_name") @db.VarChar(255)
  mimeType     String           @map("mime_type") @db.VarChar(100)
  sizeBytes    Int              @map("size_bytes")
  /// Empreinte SHA-256 du contenu : détection des doublons et intégrité.
  sha256       String           @db.Char(64)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Retrait par le contributeur (brouillon ou correction) : la ligne est conservée.
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(3)

  jobOffer   JobOffer          @relation(fields: [jobOfferId], references: [id], onDelete: Restrict)
  uploadedBy User              @relation("JobOfferFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  downloads  FileDownloadLog[]

  @@index([jobOfferId, deletedAt])
  @@index([sha256])
  @@map("job_offer_files")
}

/// Journal des téléchargements (cahier des charges §8.4), en ajout seul.
model FileDownloadLog {
  id        String              @id @default(uuid(7)) @db.Uuid
  fileId    String              @map("file_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   FileDownloadPurpose
  ip        String?             @db.VarChar(45)
  userAgent String?             @map("user_agent") @db.VarChar(512)
  requestId String?             @map("request_id") @db.VarChar(64)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  file JobOfferFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  user User         @relation("FileDownloader", fields: [userId], references: [id], onDelete: Restrict)

  @@index([fileId, createdAt])
  @@index([userId, createdAt])
  @@map("file_download_logs")
}

/// Offres enregistrées (favoris) d'un utilisateur.
model SavedJob {
  userId     String   @map("user_id") @db.Uuid
  jobOfferId String   @map("job_offer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobOffer JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  @@id([userId, jobOfferId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_jobs")
}
