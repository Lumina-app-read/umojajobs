// Schéma de données OPPORTINITIES (PostgreSQL, Prisma 7).
// Conventions : identifiants UUID v7, colonnes et tables en snake_case, dates en timestamptz.
// Le schéma est complété module par module, au fil des phases.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Référentiel des 54 États africains (source : packages/shared/src/countries.ts).
model Country {
  id              String   @id @default(uuid(7)) @db.Uuid
  iso2            String   @unique @db.Char(2)
  iso3            String   @unique @db.Char(3)
  nameFr          String   @map("name_fr") @db.VarChar(100)
  nameEn          String   @map("name_en") @db.VarChar(100)
  officialNameFr  String   @map("official_name_fr") @db.VarChar(150)
  officialNameEn  String   @map("official_name_en") @db.VarChar(150)
  /// Indicatif international au format E.164, par exemple « +243 ».
  dialCode        String   @map("dial_code") @db.VarChar(6)
  flagEmoji       String   @map("flag_emoji") @db.VarChar(16)
  currencyCode    String   @map("currency_code") @db.Char(3)
  defaultTimezone String   @map("default_timezone") @db.VarChar(64)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cities    City[]
  users     User[]
  jobOffers JobOffer[]

  @@map("countries")
}

enum CitySource {
  geonames
  admin

  @@map("city_source")
}

/// Villes : import GeoNames (CC BY 4.0) et ajouts de l'administration.
model City {
  id          String     @id @default(uuid(7)) @db.Uuid
  countryId   String     @map("country_id") @db.Uuid
  /// Identifiant GeoNames ; vide pour une ville ajoutée par l'administration.
  geonamesId  Int?       @unique @map("geonames_id")
  name        String     @db.VarChar(200)
  asciiName   String     @map("ascii_name") @db.VarChar(200)
  /// Nom normalisé pour la recherche (minuscules, sans accents).
  searchName  String     @map("search_name") @db.VarChar(200)
  regionName  String?    @map("region_name") @db.VarChar(200)
  latitude    Decimal?   @db.Decimal(9, 6)
  longitude   Decimal?   @db.Decimal(9, 6)
  population  Int        @default(0)
  timezone    String     @db.VarChar(64)
  featureCode String?    @map("feature_code") @db.VarChar(10)
  source      CitySource @default(geonames)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  country   Country    @relation(fields: [countryId], references: [id], onDelete: Restrict)
  jobOffers JobOffer[]

  @@index([countryId, population(sort: Desc)])
  @@index([searchName(ops: raw("gin_trgm_ops"))], type: Gin, map: "cities_search_name_trgm_idx")
  @@map("cities")
}

// ---------------------------------------------------------------------------
// Phase 1c — Identité, sessions, rôles et sécurité
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended

  @@map("user_status")
}

enum Locale {
  fr
  en

  @@map("locale")
}

enum ThemePreference {
  light
  dark
  system

  @@map("theme_preference")
}

enum RoleCode {
  user
  moderator
  admin
  super_admin

  @@map("role_code")
}

enum VerificationTokenType {
  email_verification
  password_reset

  @@map("verification_token_type")
}

enum SecurityEventType {
  user_registered
  registration_attempt_existing_email
  email_verification_sent
  email_verified
  login_succeeded
  login_failed
  account_locked
  logout
  logout_all
  session_revoked
  password_reset_requested
  password_reset_completed
  password_changed
  mfa_enrollment_started
  mfa_enabled
  mfa_verified
  mfa_failed
  mfa_recovery_code_used
  role_granted
  role_revoked
  profile_updated
  contributor_terms_accepted
  financial_setting_changed
  credits_granted
  candidate_terms_accepted
  withdrawal_requested
  withdrawal_status_changed
  credit_pack_changed

  @@map("security_event_type")
}

/// Compte unique : recherche d'emploi, publication, commissions et documents.
model User {
  id                         String          @id @default(uuid(7)) @db.Uuid
  /// Insensible à la casse (citext) : une seule inscription par adresse.
  email                      String          @unique @db.Citext
  passwordHash               String          @map("password_hash") @db.VarChar(255)
  firstName                  String          @map("first_name") @db.VarChar(100)
  lastName                   String          @map("last_name") @db.VarChar(100)
  countryId                  String          @map("country_id") @db.Uuid
  /// Facultatif, au format E.164 (profil ou moment d'un paiement).
  phoneE164                  String?         @map("phone_e164") @db.VarChar(16)
  locale                     Locale          @default(fr)
  theme                      ThemePreference @default(system)
  status                     UserStatus      @default(active)
  emailVerifiedAt            DateTime?       @map("email_verified_at") @db.Timestamptz(3)
  termsAcceptedAt            DateTime        @map("terms_accepted_at") @db.Timestamptz(3)
  termsVersion               String          @map("terms_version") @db.VarChar(32)
  /// Conditions de publication des offres : version acceptée et date (preuve d'acceptation).
  contributorTermsVersion    String?         @map("contributor_terms_version") @db.VarChar(32)
  contributorTermsAcceptedAt DateTime?       @map("contributor_terms_accepted_at") @db.Timestamptz(3)
  /// Règlement des candidats : version acceptée et date (après le premier déverrouillage).
  candidateTermsVersion      String?         @map("candidate_terms_version") @db.VarChar(32)
  candidateTermsAcceptedAt   DateTime?       @map("candidate_terms_accepted_at") @db.Timestamptz(3)
  failedLoginCount           Int             @default(0) @map("failed_login_count")
  lockedUntil                DateTime?       @map("locked_until") @db.Timestamptz(3)
  lastLoginAt                DateTime?       @map("last_login_at") @db.Timestamptz(3)
  /// Secret TOTP chiffré (AES-256-GCM). Jamais stocké ni renvoyé en clair.
  totpSecretEncrypted        String?         @map("totp_secret_encrypted") @db.VarChar(255)
  totpPendingSecretEncrypted String?         @map("totp_pending_secret_encrypted") @db.VarChar(255)
  totpEnabledAt              DateTime?       @map("totp_enabled_at") @db.Timestamptz(3)
  /// Dernier pas de temps TOTP accepté : empêche la réutilisation d'un code.
  totpLastUsedStep           Int?            @map("totp_last_used_step")
  createdAt                  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  country             Country                 @relation(fields: [countryId], references: [id], onDelete: Restrict)
  roles               UserRole[]              @relation("UserRoles")
  rolesAssigned       UserRole[]              @relation("RoleAssignedBy")
  sessions            Session[]
  verificationTokens  VerificationToken[]
  recoveryCodes       MfaRecoveryCode[]
  securityEvents      SecurityEvent[]
  jobOffers           JobOffer[]              @relation("JobOfferContributor")
  reviewedJobOffers   JobOffer[]              @relation("JobOfferReviewer")
  jobStatusChanges    JobOfferStatusHistory[] @relation("JobOfferStatusActor")
  jobRevisions        JobOfferRevision[]      @relation("JobOfferRevisionAuthor")
  jobFiles            JobOfferFile[]          @relation("JobOfferFileUploader")
  fileDownloads       FileDownloadLog[]       @relation("FileDownloader")
  savedJobs           SavedJob[]
  financialSettings   FinancialSetting[]      @relation("FinancialSettingAuthor")
  serviceCosts        ServiceCreditCost[]     @relation("ServiceCostAuthor")
  creditAccount       CreditAccount?
  creditMovements     CreditMovement[]        @relation("CreditMovementActor")
  ledgerAccounts      LedgerAccount[]         @relation("LedgerAccountOwner")
  ledgerTransactions  LedgerTransaction[]     @relation("LedgerTransactionActor")
  jobUnlocks          JobUnlock[]             @relation("JobUnlockUser")
  commissions         Commission[]            @relation("CommissionContributor")
  commissionEvents    CommissionEvent[]       @relation("CommissionEventActor")
  withdrawalMethods   WithdrawalMethod[]      @relation("WithdrawalMethodOwner")
  withdrawals         WithdrawalRequest[]     @relation("WithdrawalRequester")
  approvedWithdrawals WithdrawalRequest[]     @relation("WithdrawalApprover")
  paidWithdrawals     WithdrawalRequest[]     @relation("WithdrawalPayer")
  withdrawalEvents    WithdrawalEvent[]       @relation("WithdrawalEventActor")
  creditOrders        CreditOrder[]           @relation("CreditOrderBuyer")
  careerDocuments     CareerDocument[]        @relation("CareerDocumentOwner")

  @@index([countryId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        RoleCode         @unique
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String           @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  /// Vide lorsque le rôle est attribué automatiquement (inscription) ou en ligne de commande.
  assignedById String?  @map("assigned_by_id") @db.Uuid
  user         User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?    @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Session serveur révocable. Seule l'empreinte SHA-256 du jeton est stockée.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  ip            String?   @db.VarChar(45)
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  /// Date de validation du TOTP pour cette session. L'obligation dépend des rôles actuels (admin, super_admin).
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(50)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Jetons à usage unique (vérification d'email, réinitialisation). Empreinte SHA-256 uniquement.
model VerificationToken {
  id        String                @id @default(uuid(7)) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  type      VerificationTokenType
  tokenHash String                @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?             @map("used_at") @db.Timestamptz(3)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

/// Codes de secours TOTP (usage unique). Empreinte SHA-256 uniquement.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

/// Journal des événements de sécurité. Ajout uniquement : UPDATE et DELETE bloqués par trigger.
model SecurityEvent {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String?           @map("user_id") @db.Uuid
  type      SecurityEventType
  ip        String?           @db.VarChar(45)
  userAgent String?           @map("user_agent") @db.VarChar(512)
  requestId String?           @map("request_id") @db.VarChar(64)
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User?             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("security_events")
}

// --- Offres d'emploi (phase 2) -------------------------------------------------------------

/// Cycle de vie d'une offre (cahier des charges §7.5). Aucune offre n'est publiée sans modération.
enum JobOfferStatus {
  draft
  pending_review
  needs_correction
  scheduled
  active
  expired
  rejected
  suspended
  archived

  @@map("job_offer_status")
}

enum ContractType {
  permanent
  fixed_term
  internship
  apprenticeship
  freelance
  consultancy
  temporary
  volunteer
  other

  @@map("contract_type")
}

enum WorkMode {
  on_site
  remote
  hybrid

  @@map("work_mode")
}

enum EducationLevel {
  none
  secondary
  vocational
  bachelor
  master
  doctorate

  @@map("education_level")
}

enum ExperienceLevel {
  none
  junior
  intermediate
  senior
  expert

  @@map("experience_level")
}

enum SalaryPeriod {
  hour
  day
  month
  year

  @@map("salary_period")
}

/// Sources possibles d'une annonce (cahier des charges §7.3).
enum JobSourceType {
  company_website
  whatsapp
  facebook
  telegram
  linkedin
  newspaper
  other_website
  other

  @@map("job_source_type")
}

/// Catégories professionnelles, administrables (noms en français et en anglais).
model JobCategory {
  id        String     @id @default(uuid(7)) @db.Uuid
  slug      String     @unique @db.VarChar(80)
  nameFr    String     @map("name_fr") @db.VarChar(120)
  nameEn    String     @map("name_en") @db.VarChar(120)
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  offers    JobOffer[]

  @@map("job_categories")
}

/// Offre partagée par un contributeur. Les champs « application » sont privés : révélés seulement
/// après déverrouillage (phase 3). Les dates de validité sont des dates calendaires interprétées
/// dans le fuseau « timezone » ; starts_at et ends_at en sont l'équivalent UTC (fin exclusive).
model JobOffer {
  id                      String           @id @default(uuid(7)) @db.Uuid
  contributorId           String           @map("contributor_id") @db.Uuid
  status                  JobOfferStatus   @default(draft)
  title                   String?          @db.VarChar(200)
  companyName             String?          @map("company_name") @db.VarChar(200)
  countryId               String?          @map("country_id") @db.Uuid
  cityId                  String?          @map("city_id") @db.Uuid
  categoryId              String?          @map("category_id") @db.Uuid
  contractType            ContractType?    @map("contract_type")
  workMode                WorkMode?        @map("work_mode")
  educationLevel          EducationLevel?  @map("education_level")
  experienceLevel         ExperienceLevel? @map("experience_level")
  salaryMin               Decimal?         @map("salary_min") @db.Decimal(14, 2)
  salaryMax               Decimal?         @map("salary_max") @db.Decimal(14, 2)
  salaryCurrency          String?          @map("salary_currency") @db.Char(3)
  salaryPeriod            SalaryPeriod?    @map("salary_period")
  description             String?
  requirements            String?
  skills                  String[]         @default([]) @db.VarChar(80)
  /// Langue de rédaction de l'annonce (conservée telle quelle, jamais traduite).
  contentLanguage         Locale?          @map("content_language")
  startDate               DateTime?        @map("start_date") @db.Date
  endDate                 DateTime?        @map("end_date") @db.Date
  timezone                String?          @db.VarChar(64)
  startsAt                DateTime?        @map("starts_at") @db.Timestamptz(3)
  endsAt                  DateTime?        @map("ends_at") @db.Timestamptz(3)
  sourceType              JobSourceType?   @map("source_type")
  sourceUrl               String?          @map("source_url") @db.VarChar(2048)
  sourceDetails           String?          @map("source_details") @db.VarChar(300)
  applicationInstructions String?          @map("application_instructions")
  applicationEmail        String?          @map("application_email") @db.Citext
  applicationUrl          String?          @map("application_url") @db.VarChar(2048)
  applicationAddress      String?          @map("application_address") @db.VarChar(500)
  /// Privé : numéro de contact E.164 communiqué par l'employeur.
  applicationPhone        String?          @map("application_phone") @db.VarChar(16)
  /// Privé : conseils du contributeur pour réussir la candidature.
  contributorTips         String?          @map("contributor_tips")
  /// Identifiant d'URL public (intitulé, entreprise, ville), attribué à la validation. Stable ensuite.
  slug                    String?          @unique @db.VarChar(180)
  /// Texte normalisé (minuscules, sans accents) pour la recherche : intitulé, entreprise,
  /// compétences, exigences et description. Index trigramme (pg_trgm).
  searchText              String?          @map("search_text")
  /// Empreinte de détection des doublons (entreprise, intitulé, pays normalisés).
  duplicateKey            String?          @map("duplicate_key") @db.Char(64)
  declarationAcceptedAt   DateTime?        @map("declaration_accepted_at") @db.Timestamptz(3)
  submittedAt             DateTime?        @map("submitted_at") @db.Timestamptz(3)
  reviewedAt              DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  reviewedById            String?          @map("reviewed_by_id") @db.Uuid
  publishedAt             DateTime?        @map("published_at") @db.Timestamptz(3)
  expiredAt               DateTime?        @map("expired_at") @db.Timestamptz(3)
  /// Incrémenté à chaque modification : protège contre les écritures concurrentes.
  version                 Int              @default(1)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  contributor   User                    @relation("JobOfferContributor", fields: [contributorId], references: [id], onDelete: Restrict)
  reviewedBy    User?                   @relation("JobOfferReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  country       Country?                @relation(fields: [countryId], references: [id], onDelete: Restrict)
  city          City?                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  category      JobCategory?            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  statusHistory JobOfferStatusHistory[]
  revisions     JobOfferRevision[]
  files         JobOfferFile[]
  savedBy       SavedJob[]
  unlocks       JobUnlock[]
  commissions   Commission[]

  @@index([contributorId, createdAt(sort: Desc)])
  @@index([status, submittedAt])
  @@index([status, startsAt])
  @@index([status, endsAt])
  @@index([duplicateKey])
  @@index([sourceUrl])
  @@index([status, publishedAt(sort: Desc)])
  @@index([status, countryId, categoryId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "job_offers_search_text_trgm_idx")
  @@map("job_offers")
}

/// Historique des changements de statut, en ajout seul (acteur, rôles, motif, contexte réseau).
model JobOfferStatusHistory {
  id         String          @id @default(uuid(7)) @db.Uuid
  jobOfferId String          @map("job_offer_id") @db.Uuid
  fromStatus JobOfferStatus? @map("from_status")
  toStatus   JobOfferStatus  @map("to_status")
  /// null : changement automatique (activation ou expiration planifiée).
  actorId    String?         @map("actor_id") @db.Uuid
  actorRoles String[]        @default([]) @map("actor_roles") @db.VarChar(32)
  reason     String?
  ip         String?         @db.VarChar(45)
  userAgent  String?         @map("user_agent") @db.VarChar(512)
  requestId  String?         @map("request_id") @db.VarChar(64)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  jobOffer JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Restrict)
  actor    User?    @relation("JobOfferStatusActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([jobOfferId, createdAt])
  @@map("job_offer_status_history")
}

/// Version soumise d'une offre (instantané figé à chaque soumission), en ajout seul.
model JobOfferRevision {
  id         String   @id @default(uuid(7)) @db.Uuid
  jobOfferId String   @map("job_offer_id") @db.Uuid
  number     Int
  authorId   String   @map("author_id") @db.Uuid
  snapshot   Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  jobOffer JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Restrict)
  author   User     @relation("JobOfferRevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([jobOfferId, number])
  @@map("job_offer_revisions")
}

// --- Fichiers des offres (phase 2c) --------------------------------------------------------

enum JobOfferFileKind {
  /// Annonce originale (PDF), une seule par offre.
  original
  /// Document complémentaire (formulaire, fiche de poste…).
  attachment

  @@map("job_offer_file_kind")
}

enum FileDownloadPurpose {
  /// Le contributeur consulte son propre document.
  owner
  /// Un modérateur examine le document.
  moderation
  /// Un utilisateur ayant déverrouillé l'offre (phase 3).
  unlock

  @@map("file_download_purpose")
}

/// Document privé d'une offre : stocké hors accès public, servi par URL signée de courte durée.
/// Index partiel « job_offer_files_one_original_idx » (une seule annonce originale par offre) créé
/// en SQL dans la migration add_job_offer_files : à conserver si une migration générée le supprime.
model JobOfferFile {
  id           String           @id @default(uuid(7)) @db.Uuid
  jobOfferId   String           @map("job_offer_id") @db.Uuid
  uploadedById String           @map("uploaded_by_id") @db.Uuid
  kind         JobOfferFileKind
  /// Clé dans le stockage objet privé (jamais exposée).
  storageKey   String           @unique @map("storage_key") @db.VarChar(300)
  originalName String           @map("original_name") @db.VarChar(255)
  mimeType     String           @map("mime_type") @db.VarChar(100)
  sizeBytes    Int              @map("size_bytes")
  /// Empreinte SHA-256 du contenu : détection des doublons et intégrité.
  sha256       String           @db.Char(64)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Retrait par le contributeur (brouillon ou correction) : la ligne est conservée.
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(3)

  jobOffer   JobOffer          @relation(fields: [jobOfferId], references: [id], onDelete: Restrict)
  uploadedBy User              @relation("JobOfferFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  downloads  FileDownloadLog[]

  @@index([jobOfferId, deletedAt])
  @@index([sha256])
  @@map("job_offer_files")
}

/// Journal des téléchargements (cahier des charges §8.4), en ajout seul.
model FileDownloadLog {
  id        String              @id @default(uuid(7)) @db.Uuid
  fileId    String              @map("file_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   FileDownloadPurpose
  ip        String?             @db.VarChar(45)
  userAgent String?             @map("user_agent") @db.VarChar(512)
  requestId String?             @map("request_id") @db.VarChar(64)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  file JobOfferFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  user User         @relation("FileDownloader", fields: [userId], references: [id], onDelete: Restrict)

  @@index([fileId, createdAt])
  @@index([userId, createdAt])
  @@map("file_download_logs")
}

/// Offres enregistrées (favoris) d'un utilisateur.
model SavedJob {
  userId     String   @map("user_id") @db.Uuid
  jobOfferId String   @map("job_offer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobOffer JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  @@id([userId, jobOfferId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_jobs")
}

// ---------------------------------------------------------------------------
// Phase 3 — Monétisation : paramètres financiers, crédits et grand livre.
// Montants en NUMERIC(20,6), crédits en entiers. Registres en ajout seul (triggers).
// ---------------------------------------------------------------------------

/// Paramètres financiers administrables (CLAUDE.md §10 et §11 : jamais codés en dur).
enum FinancialSettingKey {
  /// Valeur interne d'un crédit en USD, figée sur chaque lot à son attribution.
  credit_unit_value_usd
  /// Part du contributeur sur la valeur des crédits consommés (0,30 = 30 %).
  contributor_commission_rate
  /// Seuil minimal d'une demande de retrait, en USD.
  withdrawal_min_usd
  /// Délai de retenue d'une commission (contributeur établi), en jours.
  commission_hold_days
  /// Délai de retenue renforcé pour un nouveau contributeur, en jours.
  commission_hold_days_new_contributor
  /// Ancienneté en deçà de laquelle un contributeur est « nouveau », en jours.
  new_contributor_period_days
  /// Montant de retrait à partir duquel deux administrateurs distincts sont requis, en USD.
  withdrawal_dual_approval_usd

  @@map("financial_setting_key")
}

/// Services payables en crédits.
enum CreditService {
  unlock_standard
  unlock_premium
  doc_cv
  doc_cover_letter
  doc_application_letter
  doc_pack

  @@map("credit_service")
}

enum CreditLotOrigin {
  /// Recharge payée (Chariow) : seule origine éligible aux commissions.
  purchase
  /// Dotation gratuite (geste commercial, promotion) : jamais commissionnable (arbitrage A2).
  grant
  adjustment

  @@map("credit_lot_origin")
}

enum CreditMovementType {
  purchase
  consume
  refund
  expire
  grant
  adjust

  @@map("credit_movement_type")
}

enum LedgerAccountType {
  asset
  liability
  revenue
  expense

  @@map("ledger_account_type")
}

enum LedgerTransactionType {
  credit_grant
  credit_consumption
  commission_accrual
  credit_purchase
  payment_settlement
  commission_release
  withdrawal_reserve
  withdrawal_release
  withdrawal_payout

  @@map("ledger_transaction_type")
}

/// Historique des valeurs : la valeur en vigueur est la plus récente dont la date d'effet est passée.
model FinancialSetting {
  id            String              @id @default(uuid(7)) @db.Uuid
  key           FinancialSettingKey
  value         Decimal             @db.Decimal(20, 6)
  effectiveFrom DateTime            @map("effective_from") @db.Timestamptz(3)
  /// Null pour les valeurs initiales chargées par le seed.
  changedById   String?             @map("changed_by_id") @db.Uuid
  reason        String              @db.VarChar(500)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  changedBy User? @relation("FinancialSettingAuthor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([key, effectiveFrom(sort: Desc)])
  @@map("financial_settings")
}

/// Coût d'un service en crédits, historisé de la même façon.
model ServiceCreditCost {
  id            String        @id @default(uuid(7)) @db.Uuid
  service       CreditService
  credits       Int
  effectiveFrom DateTime      @map("effective_from") @db.Timestamptz(3)
  changedById   String?       @map("changed_by_id") @db.Uuid
  reason        String        @db.VarChar(500)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  changedBy User? @relation("ServiceCostAuthor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([service, effectiveFrom(sort: Desc)])
  @@map("service_credit_costs")
}

/// Compte de crédits d'un utilisateur. La ligne est verrouillée (FOR UPDATE) à chaque mouvement.
model CreditAccount {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  /// Solde en cache, égal à la somme des mouvements (contrôlé par la réconciliation).
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  lots      CreditLot[]
  movements CreditMovement[]

  @@map("credit_accounts")
}

/// Lot de crédits : consommé du plus ancien au plus récent (FIFO).
model CreditLot {
  id                 String          @id @default(uuid(7)) @db.Uuid
  accountId          String          @map("account_id") @db.Uuid
  origin             CreditLotOrigin
  creditsTotal       Int             @map("credits_total")
  creditsRemaining   Int             @map("credits_remaining")
  /// Valeur interne d'un crédit au moment de l'attribution (arbitrage A1 : figée par lot).
  creditUnitValueUsd Decimal         @map("credit_unit_value_usd") @db.Decimal(20, 6)
  commissionable     Boolean
  /// Recharge payée d'origine (lot « purchase ») : une seule attribution par paiement.
  paymentId          String?         @unique @map("payment_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  account     CreditAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  allocations CreditLotAllocation[]
  payment     Payment?              @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@map("credit_lots")
}

/// Registre des crédits, en ajout seul : le solde est la somme des quantités.
model CreditMovement {
  id             String             @id @default(uuid(7)) @db.Uuid
  accountId      String             @map("account_id") @db.Uuid
  type           CreditMovementType
  /// Positive pour une entrée, négative pour une sortie.
  quantity       Int
  balanceAfter   Int                @map("balance_after")
  /// Rejouer une même opération ne produit jamais un second mouvement.
  idempotencyKey String             @unique @map("idempotency_key") @db.VarChar(200)
  referenceType  String?            @map("reference_type") @db.VarChar(50)
  referenceId    String?            @map("reference_id") @db.Uuid
  actorId        String?            @map("actor_id") @db.Uuid
  reason         String?            @db.VarChar(500)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  jobUnlock   JobUnlock?
  account     CreditAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  actor       User?                 @relation("CreditMovementActor", fields: [actorId], references: [id], onDelete: Restrict)
  allocations CreditLotAllocation[]

  @@index([accountId, createdAt(sort: Desc)])
  @@map("credit_movements")
}

/// Lots touchés par un mouvement, avec la valeur correspondante (base des commissions).
model CreditLotAllocation {
  id         String   @id @default(uuid(7)) @db.Uuid
  movementId String   @map("movement_id") @db.Uuid
  lotId      String   @map("lot_id") @db.Uuid
  credits    Int
  valueUsd   Decimal  @map("value_usd") @db.Decimal(20, 6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  movement CreditMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  lot      CreditLot      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([movementId, lotId])
  @@index([lotId])
  @@map("credit_lot_allocations")
}

/// Plan de comptes (audit §6.2). Les comptes d'un contributeur portent son identifiant.
model LedgerAccount {
  id          String            @id @default(uuid(7)) @db.Uuid
  code        String            @unique @db.VarChar(100)
  type        LedgerAccountType
  ownerUserId String?           @map("owner_user_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  owner   User?         @relation("LedgerAccountOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@index([ownerUserId])
  @@map("ledger_accounts")
}

/// Transaction comptable équilibrée (vérifié en base à la validation de la transaction SQL).
model LedgerTransaction {
  id                    String                @id @default(uuid(7)) @db.Uuid
  type                  LedgerTransactionType
  referenceType         String?               @map("reference_type") @db.VarChar(50)
  referenceId           String?               @map("reference_id") @db.Uuid
  idempotencyKey        String                @unique @map("idempotency_key") @db.VarChar(200)
  /// Écriture compensatoire : transaction d'origine annulée par celle-ci.
  reversesTransactionId String?               @map("reverses_transaction_id") @db.Uuid
  actorId               String?               @map("actor_id") @db.Uuid
  reason                String?               @db.VarChar(500)
  occurredAt            DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(3)

  reverses          LedgerTransaction?  @relation("LedgerReversal", fields: [reversesTransactionId], references: [id], onDelete: Restrict)
  reversedBy        LedgerTransaction[] @relation("LedgerReversal")
  actor             User?               @relation("LedgerTransactionActor", fields: [actorId], references: [id], onDelete: Restrict)
  entries           LedgerEntry[]
  commission        Commission?
  withdrawalReserve WithdrawalRequest?  @relation("WithdrawalReserve")

  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

/// Ligne d'écriture : un débit ou un crédit strictement positif, jamais les deux.
model LedgerEntry {
  id            String  @id @default(uuid(7)) @db.Uuid
  transactionId String  @map("transaction_id") @db.Uuid
  accountId     String  @map("account_id") @db.Uuid
  debit         Decimal @default(0) @db.Decimal(20, 6)
  credit        Decimal @default(0) @db.Decimal(20, 6)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Phase 3b — Déverrouillages et commissions.
// ---------------------------------------------------------------------------

/// États d'une commission (CLAUDE.md §10). Les transitions sont historisées.
enum CommissionStatus {
  pending
  available
  paid
  reversed

  @@map("commission_status")
}

/// Déverrouillage d'une offre par un utilisateur : définitif, une seule fois par offre.
model JobUnlock {
  id         String        @id @default(uuid(7)) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  jobOfferId String        @map("job_offer_id") @db.Uuid
  service    CreditService
  credits    Int
  movementId String        @unique @map("movement_id") @db.Uuid
  /// Valeur interne des crédits consommés (somme des lots touchés).
  valueUsd   Decimal       @map("value_usd") @db.Decimal(20, 6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User           @relation("JobUnlockUser", fields: [userId], references: [id], onDelete: Restrict)
  jobOffer   JobOffer       @relation(fields: [jobOfferId], references: [id], onDelete: Restrict)
  movement   CreditMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  commission Commission?

  @@unique([userId, jobOfferId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([jobOfferId])
  @@map("job_unlocks")
}

/// Commission du contributeur sur un déverrouillage éligible (crédits payés uniquement).
model Commission {
  id                  String           @id @default(uuid(7)) @db.Uuid
  unlockId            String           @unique @map("unlock_id") @db.Uuid
  contributorId       String           @map("contributor_id") @db.Uuid
  jobOfferId          String           @map("job_offer_id") @db.Uuid
  /// Valeur des crédits consommés issus de recharges payées (base du calcul).
  baseValueUsd        Decimal          @map("base_value_usd") @db.Decimal(20, 6)
  /// Taux en vigueur au moment du déverrouillage.
  rate                Decimal          @db.Decimal(9, 6)
  amountUsd           Decimal          @map("amount_usd") @db.Decimal(20, 6)
  status              CommissionStatus @default(pending)
  availableAt         DateTime?        @map("available_at") @db.Timestamptz(3)
  reversedAt          DateTime?        @map("reversed_at") @db.Timestamptz(3)
  ledgerTransactionId String           @unique @map("ledger_transaction_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  unlock                JobUnlock                        @relation(fields: [unlockId], references: [id], onDelete: Restrict)
  contributor           User                             @relation("CommissionContributor", fields: [contributorId], references: [id], onDelete: Restrict)
  jobOffer              JobOffer                         @relation(fields: [jobOfferId], references: [id], onDelete: Restrict)
  ledgerTransaction     LedgerTransaction                @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  events                CommissionEvent[]
  withdrawalAllocations WithdrawalCommissionAllocation[]

  @@index([contributorId, status, createdAt(sort: Desc)])
  @@index([jobOfferId])
  @@map("commissions")
}

/// Historique des états d'une commission, en ajout seul.
model CommissionEvent {
  id           String            @id @default(uuid(7)) @db.Uuid
  commissionId String            @map("commission_id") @db.Uuid
  fromStatus   CommissionStatus? @map("from_status")
  toStatus     CommissionStatus  @map("to_status")
  actorId      String?           @map("actor_id") @db.Uuid
  reason       String?           @db.VarChar(500)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  actor      User?      @relation("CommissionEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([commissionId, createdAt])
  @@map("commission_events")
}

// ---------------------------------------------------------------------------
// Phase 3d — Retraits des contributeurs (audit §7, CLAUDE.md §11).
// ---------------------------------------------------------------------------

enum WithdrawalMethodType {
  mobile_money
  bank_transfer

  @@map("withdrawal_method_type")
}

/// États d'une demande de retrait (CLAUDE.md §11). `paid` exige référence et date du versement.
enum WithdrawalStatus {
  pending
  under_review
  approved
  processing
  paid
  rejected

  @@map("withdrawal_status")
}

/// Moyen de retrait d'un utilisateur. Les coordonnées sont chiffrées (AES-256-GCM).
model WithdrawalMethod {
  id               String               @id @default(uuid(7)) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  type             WithdrawalMethodType
  countryIso2      String               @map("country_iso2") @db.Char(2)
  /// Opérateur ou banque, affichable (« Orange Money », « Rawbank »).
  provider         String               @db.VarChar(100)
  /// Fin du numéro ou du compte, seule partie affichée (« ••• 4567 »).
  maskedAccount    String               @map("masked_account") @db.VarChar(40)
  /// Coordonnées complètes chiffrées : jamais renvoyées à l'utilisateur, lues par l'administration.
  detailsEncrypted String               @map("details_encrypted")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt       DateTime?            @map("archived_at") @db.Timestamptz(3)

  user     User                @relation("WithdrawalMethodOwner", fields: [userId], references: [id], onDelete: Restrict)
  requests WithdrawalRequest[]

  @@index([userId, archivedAt])
  @@map("withdrawal_methods")
}

/// Demande de retrait : le montant est réservé dès la création (écriture au grand livre).
model WithdrawalRequest {
  id                   String           @id @default(uuid(7)) @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  methodId             String           @map("method_id") @db.Uuid
  amountUsd            Decimal          @map("amount_usd") @db.Decimal(20, 6)
  status               WithdrawalStatus @default(pending)
  approvedById         String?          @map("approved_by_id") @db.Uuid
  approvedAt           DateTime?        @map("approved_at") @db.Timestamptz(3)
  paidById             String?          @map("paid_by_id") @db.Uuid
  paidAt               DateTime?        @map("paid_at") @db.Timestamptz(3)
  /// Référence de l'opérateur ou de la banque, obligatoire pour `paid`.
  payoutReference      String?          @map("payout_reference") @db.VarChar(120)
  rejectionReason      String?          @map("rejection_reason") @db.VarChar(1000)
  reserveTransactionId String           @unique @map("reserve_transaction_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                             @relation("WithdrawalRequester", fields: [userId], references: [id], onDelete: Restrict)
  method             WithdrawalMethod                 @relation(fields: [methodId], references: [id], onDelete: Restrict)
  approvedBy         User?                            @relation("WithdrawalApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  paidBy             User?                            @relation("WithdrawalPayer", fields: [paidById], references: [id], onDelete: Restrict)
  reserveTransaction LedgerTransaction                @relation("WithdrawalReserve", fields: [reserveTransactionId], references: [id], onDelete: Restrict)
  events             WithdrawalEvent[]
  allocations        WithdrawalCommissionAllocation[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("withdrawal_requests")
}

/// Historique des états d'une demande de retrait, en ajout seul.
model WithdrawalEvent {
  id           String            @id @default(uuid(7)) @db.Uuid
  withdrawalId String            @map("withdrawal_id") @db.Uuid
  fromStatus   WithdrawalStatus? @map("from_status")
  toStatus     WithdrawalStatus  @map("to_status")
  actorId      String?           @map("actor_id") @db.Uuid
  note         String?           @db.VarChar(1000)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  withdrawal WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  actor      User?             @relation("WithdrawalEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([withdrawalId, createdAt])
  @@map("withdrawal_events")
}

/// Commissions couvertes par une demande, dans l'ordre chronologique (la dernière en partie).
model WithdrawalCommissionAllocation {
  id           String    @id @default(uuid(7)) @db.Uuid
  withdrawalId String    @map("withdrawal_id") @db.Uuid
  commissionId String    @map("commission_id") @db.Uuid
  amountUsd    Decimal   @map("amount_usd") @db.Decimal(20, 6)
  /// Renseigné si la demande est refusée : le montant redevient disponible.
  releasedAt   DateTime? @map("released_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  withdrawal WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  commission Commission        @relation(fields: [commissionId], references: [id], onDelete: Restrict)

  @@unique([withdrawalId, commissionId])
  @@index([commissionId])
  @@map("withdrawal_commission_allocations")
}

// ---------------------------------------------------------------------------
// Phase 3c — Recharges de crédits payées par Chariow (produits License).
// ---------------------------------------------------------------------------

/// Pack de crédits vendu (un produit License Chariow par pack). Prix et crédits administrables.
model CreditPack {
  id               String   @id @default(uuid(7)) @db.Uuid
  sku              String   @unique @db.VarChar(40)
  name             String   @db.VarChar(100)
  credits          Int
  priceUsd         Decimal  @map("price_usd") @db.Decimal(20, 2)
  /// Identifiant du produit License chez Chariow (prd_…). Sans lui, le pack n'est pas en vente.
  chariowProductId String?  @unique @map("chariow_product_id") @db.VarChar(100)
  isActive         Boolean  @default(false) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders CreditOrder[]

  @@map("credit_packs")
}

enum CreditOrderStatus {
  pending
  paid
  failed
  abandoned
  /// Paiement reçu mais incohérent (produit, montant ou devise) : aucun crédit, revue manuelle.
  anomaly

  @@map("credit_order_status")
}

/// Commande de recharge : prix, crédits et valeur figés à la création (snapshot).
model CreditOrder {
  id                 String            @id @default(uuid(7)) @db.Uuid
  reference          String            @unique @db.VarChar(40)
  userId             String            @map("user_id") @db.Uuid
  packId             String            @map("pack_id") @db.Uuid
  credits            Int
  priceUsd           Decimal           @map("price_usd") @db.Decimal(20, 2)
  creditUnitValueUsd Decimal           @map("credit_unit_value_usd") @db.Decimal(20, 6)
  chariowProductId   String            @map("chariow_product_id") @db.VarChar(100)
  status             CreditOrderStatus @default(pending)
  /// Vente Chariow (sal_…) renvoyée à l'ouverture du paiement : clé du rapprochement.
  providerSaleId     String?           @unique @map("provider_sale_id") @db.VarChar(100)
  checkoutUrl        String?           @map("checkout_url")
  failureReason      String?           @map("failure_reason") @db.VarChar(500)
  paidAt             DateTime?         @map("paid_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User       @relation("CreditOrderBuyer", fields: [userId], references: [id], onDelete: Restrict)
  pack    CreditPack @relation(fields: [packId], references: [id], onDelete: Restrict)
  payment Payment?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("credit_orders")
}

/// Paiement confirmé par relecture de la vente chez Chariow (jamais sur la seule notification).
model Payment {
  id               String    @id @default(uuid(7)) @db.Uuid
  orderId          String    @unique @map("order_id") @db.Uuid
  provider         String    @db.VarChar(20)
  providerSaleId   String    @map("provider_sale_id") @db.VarChar(100)
  amountUsd        Decimal   @map("amount_usd") @db.Decimal(20, 2)
  currency         String    @db.Char(3)
  /// Montant net versé par Chariow après frais (connu au règlement).
  settlementAmount Decimal?  @map("settlement_amount") @db.Decimal(20, 2)
  serviceFee       Decimal?  @map("service_fee") @db.Decimal(20, 2)
  settlementDueAt  DateTime? @map("settlement_due_at") @db.Timestamptz(3)
  settlementDoneAt DateTime? @map("settlement_done_at") @db.Timestamptz(3)
  saleStatus       String    @map("sale_status") @db.VarChar(30)
  rawSnapshot      Json      @map("raw_snapshot")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  order CreditOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lot   CreditLot?

  @@unique([provider, providerSaleId])
  @@map("payments")
}

/// Notification reçue d'un prestataire (Pulse Chariow), conservée telle quelle.
model PaymentEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  provider       String    @db.VarChar(20)
  /// x-pulse-delivery-id : identique à chaque nouvelle tentative d'une même notification.
  deliveryId     String    @map("delivery_id") @db.VarChar(100)
  eventType      String    @map("event_type") @db.VarChar(60)
  signatureValid Boolean   @map("signature_valid")
  payload        Json
  saleId         String?   @map("sale_id") @db.VarChar(100)
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  error          String?   @db.VarChar(500)

  @@unique([provider, deliveryId])
  @@index([saleId])
  @@map("payment_events")
}

// ---------------------------------------------------------------------------
// Phase 4 — Career Studio : documents professionnels (CV, lettres).
// ---------------------------------------------------------------------------

/// Types de documents (cahier des charges §11) ; architecture extensible.
enum CareerDocumentType {
  cv
  cover_letter
  application_letter
  internship_request
  recommendation_draft
  resignation_letter
  follow_up_letter
  thank_you_letter

  @@map("career_document_type")
}

/// Document de l'utilisateur : contenu structuré (JSON validé par l'API selon le type),
/// modèle de mise en page et langue. Brouillon gratuit ; l'export PDF est payé en crédits.
model CareerDocument {
  id          String             @id @default(uuid(7)) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  type        CareerDocumentType
  title       String             @db.VarChar(120)
  language    Locale
  templateKey String             @map("template_key") @db.VarChar(40)
  content     Json
  /// Version optimiste : une modification concurrente est refusée.
  version     Int                @default(1)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Suppression par l'utilisateur : la ligne est conservée (exports déjà payés).
  deletedAt   DateTime?          @map("deleted_at") @db.Timestamptz(3)

  user User @relation("CareerDocumentOwner", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, deletedAt, updatedAt(sort: Desc)])
  @@map("career_documents")
}
