# Modèle des variables de production. Copier en `.env.production` à la racine du dépôt, sur le
# serveur uniquement (jamais versionné), puis remplacer chaque valeur.
# Mots de passe : uniquement des caractères hexadécimaux (openssl rand -hex 32), car ils sont
# insérés dans les URLs de connexion à PostgreSQL et Redis.

# --- Domaine et images ---
# Adresse publique du site (sans barre finale) et nom de domaine servi par Nginx.
SITE_URL=https://umojajobs.example
SERVER_NAME=umojajobs.example
IMAGE_TAG=latest
HTTP_PORT=80
HTTPS_PORT=443
# Certificats Let's Encrypt (dossier live/<SERVER_NAME>/) et dossier de validation HTTP.
LETSENCRYPT_DIR=/etc/letsencrypt
ACME_WEBROOT=/var/www/acme

# --- PostgreSQL et Redis (conteneurs internes) ---
POSTGRES_USER=umoja
POSTGRES_PASSWORD=<openssl rand -hex 32>
POSTGRES_DB=umoja
REDIS_PASSWORD=<openssl rand -hex 32>

# --- Sécurité ---
# Clé AES-256 des secrets TOTP : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ne jamais la changer après la mise en service (les doubles authentifications deviendraient illisibles).
APP_ENCRYPTION_KEY=<32 octets en base64>
# Jeton partagé entre l'application web et l'API (lectures publiques en cache) : openssl rand -hex 32
INTERNAL_API_TOKEN=<openssl rand -hex 32>
TERMS_VERSION=2026-11-09
SESSION_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_HOURS=168
PRIVILEGED_SESSION_TTL_HOURS=6
PRIVILEGED_SESSION_IDLE_TIMEOUT_MINUTES=15
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
SCHEDULED_TASKS_ENABLED=true

# --- Emails : Brevo SMTP ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<identifiant SMTP Brevo>
SMTP_PASSWORD=<clé SMTP Brevo>
MAIL_FROM=Umoja Jobs <no-reply@umojajobs.example>

# --- Stockage objet privé ---
# Fournisseur S3 externe : son point d'accès, sa région et ses clés.
# Garage auto-hébergé (profil « garage ») : S3_ENDPOINT=http://garage:3900, S3_REGION=garage,
# S3_FORCE_PATH_STYLE=true, et les deux secrets Garage ci-dessous.
S3_ENDPOINT=https://s3.fournisseur.example
S3_REGION=<région>
S3_BUCKET=umoja-private
S3_ACCESS_KEY_ID=<clé d'accès>
S3_SECRET_ACCESS_KEY=<secret>
S3_FORCE_PATH_STYLE=false
FILE_URL_TTL_SECONDS=60
JOB_FILE_MAX_MB=10
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# --- Paiements Chariow (recharges de crédits) ---
CHARIOW_API_BASE_URL=https://api.chariow.com/v1
CHARIOW_API_KEY=
CHARIOW_PULSE_SECRET=

# --- OpenAI (Career Studio) ---
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
STUDIO_AI_DAILY_LIMIT=60
OPENAI_PRICE_INPUT_USD_PER_MTOK=
OPENAI_PRICE_OUTPUT_USD_PER_MTOK=
