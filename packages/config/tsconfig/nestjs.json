{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "OPPORTINITIES — NestJS",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": false,
    "declaration": false,
    "sourceMap": true,
    "incremental": true,
    "types": ["node"]
  }
}
