{
  "name": "@opportinities/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Types, constantes et schémas partagés entre le frontend et le backend.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@opportinities/config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  }
}
