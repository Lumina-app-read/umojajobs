{
  "name": "@opportinities/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Catalogues de traduction centralisés (fr, en) : interface, emails, notifications, erreurs.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/translate.test.ts"
  },
  "devDependencies": {
    "@opportinities/config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
